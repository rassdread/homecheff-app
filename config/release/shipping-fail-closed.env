# Release configuration for EctaroShip parcel checkout fail-closed.
# Owner-approved production activation only — do NOT set these on Vercel until approved.
#
# When SHIPPING_CHECKOUT_REQUIRES_LABEL_PATH=true and labels are NOT certified,
# checkout rejects PARCEL_SHIPPING / SHIPPING with 503 SHIPPING_LABEL_PATH_UNAVAILABLE.
# Pickup, seller delivery, HomeCheff courier, and digital orders are unaffected.
#
# Do NOT set SHIPPING_LABELS_CERTIFIED=true until real label creation is certified.

SHIPPING_CHECKOUT_REQUIRES_LABEL_PATH=true
# SHIPPING_LABELS_CERTIFIED=false
