# Release configuration for EctaroShip parcel shipping.
# Owner-approved production activation only — do NOT set these on Vercel until approved.
#
# Partner API (required). Legacy https://api.ectaroship.nl returns HTTP 526 and must not be used.
# Runtime also remaps that legacy host to the Partner base if still present in env.
ECTAROSHIP_API_BASE_URL=https://partnerapi.ectaro.com
# ECTAROSHIP_API_KEY=<server-only Partner Api-Key>
#
# When SHIPPING_CHECKOUT_REQUIRES_LABEL_PATH=true and labels are NOT certified,
# checkout rejects PARCEL_SHIPPING / SHIPPING with 503 SHIPPING_LABEL_PATH_UNAVAILABLE.
# Pickup, seller delivery, HomeCheff courier, and digital orders are unaffected.
#
# Do NOT set SHIPPING_LABELS_CERTIFIED=true until a controlled label create is certified.

SHIPPING_CHECKOUT_REQUIRES_LABEL_PATH=true
# SHIPPING_LABELS_CERTIFIED=false
